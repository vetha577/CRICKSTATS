<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Runs_Not_Negative</fullName>
<active>true</active>
<description>Runs Scored cannot be negative.</description>
<errorConditionFormula>BLANKVALUE(Runs_Scored__c, 0) &lt; 0</errorConditionFormula>
<errorDisplayField>Runs_Scored__c</errorDisplayField>
<errorMessage>Runs Scored cannot be negative.</errorMessage>
</ValidationRule>
